# Variables de entorno para el entorno local con Docker Compose.
# Copia a .env.docker (o exporta en tu shell) y ajusta los valores.
POSTGRES_DB=mhw
POSTGRES_USER=mhw
POSTGRES_PASSWORD=mhw
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=1

# Para conectar a la BD de producción (Supabase/Neon/Vercel Postgres) desde
# local y ejecutar migrate / ETL:
#   export $(grep -v '^#' .env.local | xargs)
# Usa la URL NO-POOLING (puerto 5432 directo) para migraciones y ETL.
# En Vercel, el runtime usa la versión pooled (puerto 6543) como DATABASE_URL.
# DATABASE_URL="postgres://user:pass@host:5432/db?sslmode=require"